{
  "name": "dsh-cache-cleaner",
  "version": "0.5.1",
  "type": "module",
  "description": "Moves the DeepSeek Harness temp cache to a configurable location and cleans it with an allowlist; also manages archived sessions and workspace temp/archive folders.",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib",
    "bin",
    "client",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strikesuitzero/dsh-cache-cleaner.git"
  },
  "homepage": "https://github.com/strikesuitzero/dsh-cache-cleaner#readme",
  "bugs": {
    "url": "https://github.com/strikesuitzero/dsh-cache-cleaner/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cache",
    "cleanup",
    "disk-space",
    "sessions"
  ]
}
